{
  "Name": "FIFINE Ampligame D6",
  "Description": "Device support plugin for FIFINE Ampligame D6",
  "Author": "TBone",
  "Version": "0.3.1",
  "PluginUUID": "com.github.tboneishh.opendeck-ampgd6",
  "CodePathLin": "opendeck-ampgd6-linux",
  "CodePathMac": "opendeck-ampgd6-mac",
  "CodePathWin": "opendeck-ampgd6-win.exe",
  "Icon": "assets/icon",
  "Category": "FIFINE D6",
  "OS": [
    {
      "Platform": "linux"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "11.3"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Previous Page",
      "UUID": "com.github.tboneishh.opendeck-ampgd6.prevpage",
      "Icon": "assets/actions/prev",
      "Tooltip": "Go to the previous page (profile), wraps around",
      "States": [
        {
          "Image": "assets/actions/prev",
          "TitleAlignment": "middle"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "Name": "Next Page",
      "UUID": "com.github.tboneishh.opendeck-ampgd6.nextpage",
      "Icon": "assets/actions/next",
      "Tooltip": "Go to the next page (profile), wraps around",
      "States": [
        {
          "Image": "assets/actions/next",
          "TitleAlignment": "middle"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "Name": "Page Counter",
      "UUID": "com.github.tboneishh.opendeck-ampgd6.pagecounter",
      "Icon": "assets/actions/counter",
      "Tooltip": "Shows the current page. Press to go back to page 1",
      "States": [
        {
          "Image": "assets/actions/counter",
          "TitleAlignment": "middle"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    }
,
    {
      "Name": "Sleep",
      "UUID": "com.github.tboneishh.opendeck-ampgd6.sleep",
      "Icon": "assets/actions/sleep",
      "Tooltip": "Turns the screen off. Press any key to turn it back on",
      "States": [
        {
          "Image": "assets/actions/sleep",
          "TitleAlignment": "middle"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    }
  ],
  "DeviceNamespace": "d6"
}
